# FRONTEND DEVELOPMENT ONLY — not the Docker/server configuration.
VITE_API_ORIGIN=http://localhost:3001

# DEVOPS: copy deploy/.env.example to deploy/.env for Docker.
# It contains AWS_REGION, S3_BUCKET, SQS_QUEUE_URL, SES_FROM_EMAIL,
# ADMIN_EMAIL, database credentials, and the application origin.
# For API development without Docker: services/api/.env.example -> services/api/.env.
# AWS setup steps: docs/operations/AWS-SETUP.md
# Full deployment commands: docs/operations/DEVOPS-HANDOFF.md
# Never put AWS credentials or server secrets in VITE_* variables.
