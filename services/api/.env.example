DATABASE_URL=postgresql://docusend:CHANGE_ME@localhost:5432/docusend?schema=public
AWS_REGION=ap-south-1
S3_BUCKET=replace-with-private-bucket-name
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT_ID/docusend-pdf
CORS_ORIGIN=http://localhost:5190
PORT=3001
MAX_PDF_BYTES=10737418240

# Worker resource bounds: maximum simultaneous uploads = render * upload.
PDF_RENDER_CONCURRENCY=2
PDF_UPLOAD_CONCURRENCY=2
# Bump this policy identifier when existing verification must be invalidated.
PDF_VERIFICATION_POLICY=clamav-poppler-v1
# Optional CDN: enable all three only after staging validation. No key in source.
# PREVIEW_CDN_ORIGIN=https://YOUR_DISTRIBUTION.cloudfront.net
# PREVIEW_CDN_KEY_PAIR_ID=YOUR_PUBLIC_KEY_ID
# PREVIEW_CDN_PRIVATE_KEY_FILE=/run/secrets/cloudfront-signing.pem
PREVIEW_CDN_TTL_SECONDS=60

SES_FROM_EMAIL=login@example.com
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
# Set to 1 only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HOPS=0
