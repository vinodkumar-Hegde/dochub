// Local synthetic stress test; uses real ClamAV/Poppler and a mocked storage sink.
import {promises as fs,createReadStream} from 'node:fs';import {join} from 'node:path';import {tmpdir} from 'node:os';import {createHash} from 'node:crypto';import {execFile} from 'node:child_process';import {promisify} from 'node:util';
import {createPrivatePagePreviews} from '../src/document-preview-render.js';
const exec=promisify(execFile),directory=await fs.mkdtemp(join(tmpdir(),'dochub-large-pdf-')),path=join(directory,'synthetic-2000-pages-1gib.pdf'),pageCount=2000,totalSize=1024**3;
const chunks:Buffer[]=[Buffer.from('%PDF-1.7\n')],offsets=[0];let offset=chunks[0]!.length;
const add=(id:number,body:string)=>{offsets[id]=offset;const buffer=Buffer.from(`${id} 0 obj\n${body}\nendobj\n`);chunks.push(buffer);offset+=buffer.length};
add(1,'<< /Type /Catalog /Pages 2 0 R >>');add(2,`<< /Type /Pages /Count ${pageCount} /Kids [${Array.from({length:pageCount},(_,i)=>`${4+i*2} 0 R`).join(' ')}] /Resources << /Font << /F1 3 0 R >> >> >>`);add(3,'<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>');
for(let i=0;i<pageCount;i++){const content=`BT /F1 24 Tf 45 900 Td (Synthetic stress test - page ${i+1}) Tj 0 -40 Td /F1 13 Tf (2000-page / 1 GiB preparation benchmark) Tj ET\n`;add(4+i*2,`<< /Type /Page /Parent 2 0 R /MediaBox [0 0 700 950] /Contents ${5+i*2} 0 R >>`);add(5+i*2,`<< /Length ${Buffer.byteLength(content)} >>\nstream\n${content}endstream`)}
const tail=(position:number)=>Buffer.from(`xref\n0 ${offsets.length}\n0000000000 65535 f \n${offsets.slice(1).map(value=>String(value).padStart(10,'0')+' 00000 n \n').join('')}trailer\n<< /Size ${offsets.length} /Root 1 0 R >>\nstartxref\n${position}\n%%EOF\n`);
const xref=totalSize-tail(totalSize).length,fd=await fs.open(path,'w');await fd.write(Buffer.concat(chunks),0,offset,0);await fd.truncate(totalSize);await fd.write(tail(xref),0,tail(xref).length,xref);await fd.close();
let peakRss=process.memoryUsage().rss,uploaded=0,active=0,maxActive=0;const started=Date.now(),keys=new Set<string>();
const timer=setInterval(()=>peakRss=Math.max(peakRss,process.memoryUsage().rss),100);
try{
 console.log(JSON.stringify({stage:'created',pages:pageCount,bytes:(await fs.stat(path)).size,sparseSynthetic:true}));
 const info=await exec('pdfinfo',[path],{timeout:60000});if(!/^Pages:\s*2000$/m.test(info.stdout))throw new Error('Page count mismatch');console.log(JSON.stringify({stage:'pdfinfo',valid:true}));
 const hash=createHash('sha256');let bytes=0;for await(const chunk of createReadStream(path,{highWaterMark:1024*1024})){bytes+=chunk.length;hash.update(chunk)}if(bytes!==totalSize)throw new Error('Stream size mismatch');console.log(JSON.stringify({stage:'stream-read',bytes,boundedStream:true}));
 const scanStart=Date.now();await exec('clamscan',['--no-summary','--max-filesize=0','--max-scansize=0',path],{timeout:20*60*1000,maxBuffer:4096});console.log(JSON.stringify({stage:'antivirus',clean:true,durationMs:Date.now()-scanStart}));
 const renderStart=Date.now();await createPrivatePagePreviews({send:async(command:any)=>{active++;maxActive=Math.max(maxActive,active);try{const {Key,Body}=command.input;if(Body[0]!==255||Body[1]!==216)throw new Error('Invalid JPEG');if(keys.has(Key))throw new Error('Duplicate page');keys.add(Key);uploaded++;if(Key.endsWith('page-000001.jpg'))await fs.writeFile('/tmp/dochub-benchmark-first.jpg',Body);if(Key.endsWith('page-002000.jpg'))await fs.writeFile('/tmp/dochub-benchmark-last.jpg',Body);if(uploaded%250===0)console.log(JSON.stringify({stage:'rendering',uploaded,pages:pageCount}));}finally{active--}}} as any,'local-test-bucket',path,directory,'11111111-1111-4111-8111-111111111111',pageCount,{renderConcurrency:2,uploadConcurrency:2});
 if(keys.size!==pageCount)throw new Error('Incomplete pages');const result={pages:pageCount,inputBytes:totalSize,preparedPages:keys.size,renderMs:Date.now()-renderStart,totalMs:Date.now()-started,peakNodeRssMiB:Math.round(peakRss/1024**2),maxConcurrentUploads:maxActive,realPoppler:true,antivirusPassed:true,syntheticSparseFile:true,uploadsMocked:true};await fs.writeFile('/tmp/dochub-large-pdf-benchmark.json',JSON.stringify(result,null,2));console.log(JSON.stringify(result));
}finally{clearInterval(timer);await fs.rm(directory,{recursive:true,force:true})}
