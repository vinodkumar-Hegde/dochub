@@ -0,0 +1,102 @@
+import { CognitoIdentityProviderClient, InitiateAuthCommand, RespondToAuthChallengeCommand } from '@aws-sdk/client-cognito-identity-provider';
+import type { FastifyInstance } from 'fastify';
+import type { PrismaClient } from '@prisma/client';
+import { z } from 'zod';
+import { randomBytes } from 'node:crypto';
+import type { Config } from './config.js';
+import { AuthError } from './auth.js';
+import { normalizeSubscriberEmail } from './otp-policy.js';
+
+const sendSchema = z.object({ email: z.string().email().max(254) }).strict();
+const verifySchema = z.object({
+  email: z.string().email().max(254),
+  code: z.string().regex(/^\d{6,8}$/),
+  session: z.string().min(10).max(8192),
+}).strict();
+
+// Per-process throttle is supplemental; production should also enable AWS WAF rate rules.
+class FixedWindowThrottle {
+  private readonly entries = new Map<string, { count: number; expires: number }>();
+  constructor(private readonly maximum: number, private readonly interval: number) {}
+  check(key: string): boolean {
+    const now = Date.now();
+    if (this.entries.size > 10_000) {
+      for (const [k, item] of this.entries) if (item.expires <= now) this.entries.delete(k);
+      if (this.entries.size > 10_000) this.entries.clear();
+    }
+    const value = this.entries.get(key);
+    if (!value || value.expires <= now) { this.entries.set(key, {count: 1, expires: now + this.interval}); return true; }
+    if (value.count >= this.maximum) return false;
+    value.count++;
+    return true;
+  }
+}
+
+export function registerEmailOtp(app: FastifyInstance, db: PrismaClient, cfg: Config): void {
+  const client = new CognitoIdentityProviderClient({region: cfg.AWS_REGION});
+  app.addHook('onClose', async () => client.destroy());
+  const sendRate = new FixedWindowThrottle(5, 10 * 60_000);
+  const verifyRate = new FixedWindowThrottle(15, 10 * 60_000);
+
+  app.post('/auth/email-otp/request', async (req) => {
+    const {email: submitted} = sendSchema.parse(req.body);
+    const email = normalizeSubscriberEmail(submitted);
+    if (!sendRate.check(`ip:${req.ip}`) || !sendRate.check(`email:${email}`)) throw new AuthError(429, 'Too many requests; try again later');
+    // Do not send sign-in codes for unprovisioned identities. Keep response generic.
+    const subscriber = await db.user.findFirst({where:{email:{equals:email,mode:'insensitive'},enabled:true,roles:{some:{role:'STUDENT'}}},select:{id:true}});
+    if (!subscriber) return {message:'If this email is registered, a verification code will be sent',session:randomBytes(256).toString('base64url')};
+    try {
+      const challenge = await client.send(new InitiateAuthCommand({
+        ClientId:cfg.COGNITO_AUDIENCE,AuthFlow:'USER_AUTH',
+        AuthParameters:{USERNAME:email,PREFERRED_CHALLENGE:'EMAIL_OTP'},
+      }));
+      if (challenge.ChallengeName === 'EMAIL_OTP' && challenge.Session) {
+        return {message:'If this email is registered, a verification code will be sent',session:challenge.Session};
+      }
+      if (challenge.ChallengeName === 'SELECT_CHALLENGE' && challenge.Session) {
+        const selected = await client.send(new RespondToAuthChallengeCommand({
+          ClientId:cfg.COGNITO_AUDIENCE,ChallengeName:'SELECT_CHALLENGE',Session:challenge.Session,
+          ChallengeResponses:{USERNAME:email,ANSWER:'EMAIL_OTP'},
+        }));
+        if (selected.ChallengeName === 'EMAIL_OTP' && selected.Session) {
+          return {message:'If this email is registered, a verification code will be sent',session:selected.Session};
+        }
+      }
+      req.log.warn({challenge:challenge.ChallengeName},'Email OTP challenge not available');
+      throw new AuthError(503,'Email OTP is not enabled for this application');
+    } catch (error) {
+      if (error instanceof AuthError) throw error;
+      const name = error && typeof error === 'object' && 'name' in error ? String(error.name) : '';
+      // Do not reveal whether a specific email exists in the identity provider.
+      if (['UserNotFoundException','NotAuthorizedException','UserNotConfirmedException'].includes(name)) {
+        return {message:'If this email is registered, a verification code will be sent',session:randomBytes(256).toString('base64url')};
+      }
+      req.log.error({err:error}, 'Cognito email OTP initiation failed');
+      throw new AuthError(503,'Email sign-in is temporarily unavailable');
+    }
+  });
+
+  app.post('/auth/email-otp/verify', async (req) => {
+    const input=verifySchema.parse(req.body);
+    if (!verifyRate.check(`verify:${req.ip}`)) throw new AuthError(429,'Too many attempts; try again later');
+    const email=normalizeSubscriberEmail(input.email);
+    try {
+      const result=await client.send(new RespondToAuthChallengeCommand({
+        ClientId:cfg.COGNITO_AUDIENCE,ChallengeName:'EMAIL_OTP',Session:input.session,
+        ChallengeResponses:{USERNAME:email,EMAIL_OTP_CODE:input.code},
+      }));
+      if (!result.AuthenticationResult?.AccessToken || !result.AuthenticationResult.ExpiresIn) {
+        throw new AuthError(401,'Invalid or expired code; request a new one');
+      }
+      return {access_token:result.AuthenticationResult.AccessToken,expires_in:result.AuthenticationResult.ExpiresIn};
+    } catch(error) {
+      if (error instanceof AuthError) throw error;
+      const name = error && typeof error === 'object' && 'name' in error ? String(error.name) : '';
+      if (['CodeMismatchException','ExpiredCodeException','NotAuthorizedException','InvalidParameterException','UserNotFoundException'].includes(name)) {
+        throw new AuthError(401,'Invalid or expired code; request a new one');
+      }
+      req.log.error({err:error},'Email OTP verification failed');
+      throw new AuthError(503,'Unable to verify code at this time');
+    }
+  });
+}
