@@ -0,0 +1,14 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { missingOtpConfiguration, normalizeSubscriberEmail } from './otp-policy.js';
+
+test('emails are normalized consistently for provision and login', () => {
+  assert.equal(normalizeSubscriberEmail('  Learner+1@EXAMPLE.COM '), 'learner+1@example.com');
+});
+test('fully configured Cognito and SES is ready', () => {
+  assert.deepEqual(missingOtpConfiguration({tier:'ESSENTIALS',factors:['PASSWORD','EMAIL_OTP'],flows:['ALLOW_USER_AUTH'],emailDelivery:'DEVELOPER',mfa:'OFF'}),[]);
+});
+test('Lite or missing SES cannot silently provision unusable students', () => {
+  const missing = missingOtpConfiguration({tier:'LITE',factors:['PASSWORD'],flows:['ALLOW_USER_SRP_AUTH'],emailDelivery:'COGNITO_DEFAULT',mfa:'ON'});
+  assert.equal(missing.length,5);
+});
