# Copy to deploy/.env; use --env-file deploy/.env with EVERY compose command.
# LOCAL SMOKE TEST ONLY. Production: NODE_ENV=production and HTTPS public origin.
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080
POSTGRES_USER=dochub
POSTGRES_DB=dochub
# Use a random URL-safe password, e.g. openssl rand -hex 32.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
APP_DB_USER=dochub_app
APP_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD
WEB_PORT=8080
IMAGE_TAG=local
# AWS resources must already exist. Setup: docs/operations/AWS-SETUP.md
# Region containing the bucket, processing queue and verified SES identity.
AWS_REGION=ap-south-1
# S3 bucket NAME only (not its ARN, URL or s3:// path).
S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
# SQS queue URL from the queue Details page (not its ARN).
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT_ID/QUEUE_NAME
# OTP sender address; verify its domain/address in SES in AWS_REGION.
# This app uses the SES API with IAM roles, not SMTP credentials.
SES_FROM_EMAIL=login@example.com
# Only bootstrap-admin reads these; no admin email is built into the application.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
MAX_PDF_BYTES=10737418240
PDF_RENDER_CONCURRENCY=2
PDF_UPLOAD_CONCURRENCY=2
PDF_VERIFICATION_POLICY=clamav-poppler-v1
PREVIEW_CDN_TTL_SECONDS=60
# Use a workload IAM role in production; no static AWS keys committed or baked in.
# Local-only alternative: inject AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and
# AWS_SESSION_TOKEN from a secure shell/secret store into API and worker.
# Optional CDN: configure all three and mount the signing file read-only.
# PREVIEW_CDN_ORIGIN=https://distribution.cloudfront.net
# PREVIEW_CDN_KEY_PAIR_ID=REPLACE_ME
# PREVIEW_CDN_PRIVATE_KEY_FILE=/run/secrets/cloudfront-signing.pem
